<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.infinite-agents.fcc-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>%HOME%/.local/bin/fcc-server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>%HOME%/litellm_proxy/fcc-server.log</string>
    <key>StandardErrorPath</key>
    <string>%HOME%/litellm_proxy/fcc-server.err</string>
</dict>
</plist>
