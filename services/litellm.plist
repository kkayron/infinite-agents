<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.infinite-agents.litellm</string>
    <key>ProgramArguments</key>
    <array>
        <string>%HOME%/litellm_proxy/venv/bin/litellm</string>
        <string>--config</string>
        <string>%HOME%/litellm_proxy/config.yaml</string>
        <string>--port</string>
        <string>4000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>%HOME%/litellm_proxy</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>%HOME%/litellm_proxy/litellm.log</string>
    <key>StandardErrorPath</key>
    <string>%HOME%/litellm_proxy/litellm.err</string>
</dict>
</plist>
